# Instant File Search Indexer: systemd unit (Linux native backend)
#
# The indexer needs CAP_SYS_ADMIN for fanotify FAN_MARK_FILESYSTEM volume
# marks (fanotify_init/fanotify_mark). CAP_DAC_OVERRIDE and CAP_DAC_READ_SEARCH
# are needed to traverse every directory on the system (e.g. drwxr-x--- home dirs).
# The Unix socket is world-writable (0666) so the user-level MCP server can
# connect even though the indexer runs as root.
#
# Install:
#   sudo cp instant-file-search-indexer.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now instant-file-search-indexer
#
# ExecStart path assumes deployment at /usr/local/lib/instant-file-search/
# (see scripts/install-linux.sh).

[Unit]
Description=Instant File Search Indexer (native Linux backend)
Documentation=https://github.com/clayleopardlabs/instant-file-search-MCP-server
After=local-fs.target

[Service]
Type=notify
# A cold-cache walk of a large filesystem takes longer than systemd's default
# 90 s start timeout (81 s warm for 1.63 M entries; a cold ntfs-3g/FUSE volume
# can take many minutes), and older logs show
# starts that were killed at 90 s and then restarted in a loop). Allow a full
# rescan before giving up.
TimeoutStartSec=900
ExecStart=/usr/local/lib/instant-file-search/instant-file-search-indexer serve
EnvironmentFile=-/etc/instant-file-search/indexer.env
Restart=on-failure
RestartSec=2
# World-readable runtime dir for startup-scan progress (scan.json), so the
# unprivileged MCP server can answer "where is the scan" while the pipe is not
# up yet. Removed automatically when the service stops.
RuntimeDirectory=instant-file-search
RuntimeDirectoryMode=0755
# fanotify FAN_MARK_FILESYSTEM requires CAP_SYS_ADMIN.
# CAP_DAC_OVERRIDE + CAP_DAC_READ_SEARCH are needed to traverse every
# directory on the system (e.g. drwxr-x--- home dirs).
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
# The indexer must read every file on the system; keep the full mount
# namespace visible and disable the private /tmp (socket lives there).
PrivateTmp=false

[Install]
WantedBy=multi-user.target
